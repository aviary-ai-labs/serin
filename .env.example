# ---------------------------------------------------------------------------
# AI provider
#
# SERIN_AI_PROVIDER: auto | anthropic_api | deepseek | claude_cli
# In "auto" mode Serin picks the first configured provider in this order:
#   1. anthropic_api  (ANTHROPIC_API_KEY)
#   2. deepseek       (DEEPSEEK_API_KEY)
#   3. claude_cli     (local development ONLY — see below)
SERIN_AI_PROVIDER=auto

# Production option A — Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Production option B — DeepSeek API key (https://platform.deepseek.com)
# OpenAI-compatible; ~20x cheaper than Sonnet for this workload.
# NOTE: legacy model name "deepseek-chat" is deprecated July 2026.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local development ONLY — Claude subscription via the Claude Code CLI.
# A personal subscription login must NOT power a deployed/production site
# (licensing + it doesn't scale). Generate with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Email delivery (optional) — any SMTP provider works.
# Gmail example: host smtp.gmail.com, port 587, username = your address,
# password = an App Password from https://myaccount.google.com/apppasswords
# (requires 2-step verification; your normal password will NOT work).
SERIN_SMTP_HOST=
SERIN_SMTP_PORT=587
SERIN_SMTP_USERNAME=
SERIN_SMTP_PASSWORD=
# auto | starttls | ssl | none  (auto = ssl on port 465, otherwise starttls)
SERIN_SMTP_TLS=auto
# Defaults to SERIN_SMTP_USERNAME when empty.
SERIN_EMAIL_FROM=
SERIN_EMAIL_TO=

# ---------------------------------------------------------------------------
# Brokerage sync (optional) — SnapTrade read-only holdings sync.
# Free for 1 connected user; create keys at https://snaptrade.com (Dashboard).
# Read-only: Serin can see holdings/balances, never place trades.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Personal/free tier only: SnapTrade pre-provisions one user at signup and
# blocks API user registration. Copy the User ID + User Secret from your
# SnapTrade dashboard. Leave blank for standard (production) keys, which
# register users via the API automatically.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ---------------------------------------------------------------------------
# Market data
#
# FMP is the recommended launch/testing provider for quotes, historical
# prices, and company profile enrichment such as sector/industry.
# SERIN_MARKET_DATA_PROVIDER currently supports fmp only. Serin does not fall
# back to any unlicensed market-data source when FMP_API_KEY is missing.
SERIN_MARKET_DATA_PROVIDER=fmp
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# ---------------------------------------------------------------------------
# App
SERIN_BACKEND_HOST=127.0.0.1
SERIN_BACKEND_PORT=8890
SERIN_FRONTEND_PORT=5174
SERIN_DB_PATH=data/serin.db
# SQLite is fine for local testing. A public multi-user launch should migrate
# to Postgres with auth-scoped user_id columns before real users connect.
# DATABASE_URL is reserved for that production migration and is not used by
# the current local SQLite backend yet.
DATABASE_URL=
